# Settings of crowd-dj. For development copy this file to .env (the devcontainer does that);
# for an installation set them in the environment of the stack (deploy/compose.yaml).

# Public URL of the app, without a trailing slash. adapter-node uses it to check form posts; the
# Spotify redirect URI is <ORIGIN>/auth/callback and must be registered in the Spotify app.
# Development: http://127.0.0.1:5173 (Spotify accepts http only for loopback IPs, not "localhost").
ORIGIN=http://127.0.0.1:5173

# SQLite database as a libsql URL. Development: a file in the working tree (ignored by git).
# The image sets file:/data/crowd-dj.db.
DATABASE_URL=file:local.db

# Spotify app from https://developer.spotify.com/dashboard (APIs: Web API, Web Playback SDK)
SPOTIFY_CLIENT_ID=
# Secret. Never commit it.
SPOTIFY_CLIENT_SECRET=

# Secret, at least 32 characters. Key for encrypting the stored Spotify tokens; changing it means
# every account has to sign in again. Generate one with:
#   openssl rand -base64 32
APP_SECRET=

# Behind a reverse proxy: the request header with the visitor's address, and how many proxies
# append to it (adapter-node's own settings). crowd-dj limits new profiles per address; without
# these every visitor would share the proxy's address. deploy/compose.yaml sets X-Forwarded-For
# and 1 (one proxy that appends the address it saw). Not needed for the dev server.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# Time zone (only used by deploy/compose.yaml)
TZ=Europe/Berlin

# deploy/compose.yaml only: the Docker network of the reverse proxy
CROWD_DJ_PROXY_NETWORK=proxy
