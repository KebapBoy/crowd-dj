# Same settings as Prettier (prettier.config.js), for editors
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# Written by drizzle-kit in its own style: SQL with tabs, JSON with two spaces
[drizzle/**.sql]
indent_style = tab

[drizzle/**.json]
indent_size = 2
